# Copy to `.env.local` for local dev (never commit secrets).

# --- Resend (contact form `/api/contact`) ---
# Create at https://resend.com — server-side only, never NEXT_PUBLIC_*
RESEND_API_KEY=

# Recipient and sender (must be allowed in Resend; use onboarding@resend.dev until oryen.be domain is verified)
CONTACT_FORM_TO=info@oryen.be
CONTACT_FORM_FROM=noreply@oryen.be

# --- Sanity (optional for full CMS-driven pages) ---
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_READ_TOKEN=

# --- Site URL (canonicals, sitemap) ---
# NEXT_PUBLIC_SITE_URL=https://oryen.be
