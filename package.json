{
  "name": "oryen",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "workspaces": ["web", "studio"],
  "overrides": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "dependencies": {
    "sanity": "^4.22.0"
  },
  "scripts": {
    "dev": "pnpm --filter @oryen/web dev",
    "dev:web": "pnpm --filter @oryen/web dev",
    "dev:studio": "pnpm --filter @oryen/studio dev",
    "build": "pnpm -r run build",
    "seed:cms": "pnpm --filter @oryen/web seed:cms",
    "lint": "pnpm -r run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11"
  }
}
